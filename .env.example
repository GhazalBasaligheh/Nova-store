# Public, non-secret configuration only. Copy to .env.local and adjust.
# NEXT_PUBLIC_* values are bundled into client code — never put secrets here.

# FakeStoreAPI base URL
NEXT_PUBLIC_API_BASE_URL=https://fakestoreapi.com

# Canonical site URL for metadata, sitemap and robots (placeholder until deployed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DEMO ONLY: fixed USD -> Toman rate used for display in the Persian locale.
# Not a live or production exchange rate.
NEXT_PUBLIC_USD_TO_TOMAN_RATE=200000
